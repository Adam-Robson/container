# Firebase web app config — copy to .env and fill in from the Firebase console:
# Project settings > General > Your apps > SDK setup and configuration
#
# These are bundled into the client at build time and are NOT secrets; Firebase
# access is controlled by Auth settings and Security Rules, not by hiding these.
VITE_APP_FIREBASE_API_KEY=
VITE_APP_FIREBASE_AUTH_DOMAIN=
VITE_APP_FIREBASE_PROJECT_ID=
VITE_APP_FIREBASE_STORAGE_BUCKET=
VITE_APP_FIREBASE_MESSAGING_SENDER_ID=
VITE_APP_FIREBASE_APP_ID=

# Optional (Google Analytics)
VITE_APP_FIREBASE_MEASUREMENT_ID=
